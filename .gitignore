# ================================================================
# OSINT BreachShield - Multi-Platform Monorepo .gitignore
# ================================================================

# OS & Editor Files
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.artifacts/
.agents/

# Secrets & Environment Configurations
.env
.env.*
!.env.example
services/api-gateway/.env
services/api-gateway/.env.*
!services/api-gateway/.env.example
apps/web-dashboard/.env
apps/web-dashboard/.env.*
!apps/web-dashboard/.env.example
services/python-scraper/.env
services/python-scraper/.env.*
!services/python-scraper/.env.example

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Virtual Environments
.venv/
venv/
env/
**/__pycache__/
**/*.pyc
**/*.pyo

# Telegram Telethon Sessions & Sensitive Credentials
*.session
*.session-journal
*.session.lock

# Databases & Runtime Data Stores
*.db
*.sqlite
*.sqlite3
instance/
services/api-gateway/instance/

# Web App Build Outputs
apps/web-dashboard/build/
build/
dist/

# Android Native Gateway Build & IDE Artifacts
apps/android-gateway/.gradle/
apps/android-gateway/build/
apps/android-gateway/*/build/
apps/android-gateway/local.properties
apps/android-gateway/.kotlin/
apps/android-gateway/.artifacts/
*.apk
*.aab

# Keystores & Signing Keys
*.jks
*.keystore
*.key
*.pepk
*.p12
