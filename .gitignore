# ================================================================
# OSINT BreachShield - .gitignore
# ================================================================

# OS & Editor Files
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.artifacts/
.agents/

# Secrets & Environment Configurations
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Virtual Environments
.venv/
venv/
env/
**/__pycache__/
**/*.pyc
**/*.pyo

# ML Model Files
*.pt
*.pth

# Telegram Telethon Sessions & Sensitive Credentials
*.session
*.session-journal
*.session.lock

# Databases & Runtime Data Stores
*.db
*.sqlite
*.sqlite3
instance/
backend/instance/
data/records/*.json
data/breach_store/*.dat
data/sessions.json
data/alerts.json
data/audit_logs.json
data/*.db

# Web App & Contract Build Outputs
frontend/build/
build/
dist/
artifacts/
**/artifacts/
cache/
**/cache/
contracts/artifacts/
contracts/cache/
contracts/node_modules/

# Android Native Gateway Build & IDE Artifacts
android-gateway/.gradle/
android-gateway/build/
android-gateway/*/build/
android-gateway/local.properties
android-gateway/.kotlin/
android-gateway/.idea/
android-gateway/app/build/
*.apk
*.aab

# Keystores & Signing Keys
*.jks
*.keystore
*.key
*.pepk
*.p12

# Archives & Binary Docs (keep academic deliverables)
*.zip
!docs/academic/*.pdf
!docs/academic/*.pptx
!docs/reports/*.docx

# Temporary & Debug Files
*.tmp
*.bak
*.swp
*.swo
*~
