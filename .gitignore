# ================================================================
# OSINT BreachShield - Multi-Platform Monorepo .gitignore
# ================================================================

# OS & Editor Files
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.artifacts/
.agents/

# Secrets & Environment Configurations
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
scraper/.env
scraper/.env.*
!scraper/.env.example

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Virtual Environments
.venv/
venv/
env/
**/__pycache__/
**/*.pyc
**/*.pyo

# Telegram Telethon Sessions & Sensitive Credentials
*.session
*.session-journal
*.session.lock

# Databases & Runtime Data Stores
*.db
*.sqlite
*.sqlite3
instance/
backend/instance/
data/records/*.json
data/breach_store/*.dat
data/sessions.json
data/alerts.json
data/audit_logs.json
data/*.db

# Web App Build Outputs
frontend/build/
build/
dist/

# Android Native Gateway Build & IDE Artifacts
apps/android-gateway/.gradle/
apps/android-gateway/build/
apps/android-gateway/*/build/
apps/android-gateway/local.properties
apps/android-gateway/.kotlin/
apps/android-gateway/.artifacts/
*.apk
*.aab

# Keystores & Signing Keys
*.jks
*.keystore
*.key
*.pepk
*.p12
