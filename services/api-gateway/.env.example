# Backend environment variables (copy this file to .env and fill the values)
# Python service endpoint (already set in scripts, optional here)
# PYTHON_SERVICE_URL=http://127.0.0.1:8001/query

# Node backend port (index.js logs 5000 by default)
# PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_me_with_strong_secret_at_least_32_chars

# Database (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=Prem@333
DB_NAME=osint_app

# Gmail account used to send OTP
GMAIL_USER=phishbreachguardians@gmail.com
# Create a Gmail App Password and put it below (do NOT use your normal password)
GMAIL_APP_PASSWORD=your_app_password_here
# Optional custom from header
# MAIL_FROM=PhishBreach Guardians <phishbreachguardians@gmail.com>

## Alternatively, use Brevo (Sendinblue) transactional email API for OTP
# BREVO_API_KEY=your_brevo_api_key_here
# MAIL_FROM_NAME=OSINT App
# MAIL_FROM_EMAIL=no-reply@example.com

# Or use a single SMTP URL instead of Gmail settings
# SMTP_URL=smtp://USER:PASS@HOST:PORT

# Data Masking (Enabled by default; omit this variable in production)
# DISABLE_DATA_MASKING=true  # DEV ONLY — never enable in production, exposes plaintext credentials/IDs
