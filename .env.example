# ==============================================================================
# OSINT-BREACHSHIELD - UNIFIED ENVIRONMENT CONFIGURATION
# Copy this file to .env at the root of the repository and populate your secrets.
# ==============================================================================

# [1] SERVER & NETWORKING
PORT=5000
FRONTEND_URL=http://localhost:3000
REACT_APP_API_BASE=http://localhost:5000
PYTHON_SERVICE_URL=http://127.0.0.1:8001/query

# [2] AUTH & SECURITY
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars_long
# DISABLE_DATA_MASKING=true  # DEV ONLY — never enable in production, exposes plaintext credentials/IDs

# [3] EMAIL SMTP (Zero-Knowledge OTP Delivery)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
OTP_EXPIRY_MINUTES=5

# [4] DATABASE (MySQL/MariaDB with automatic JSON file fallback)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=osint_app

# [5] TELEGRAM OSINT LIVE SCRAPER
TG_PHONE=+919876543210
TG_SESSION=osint_bot_session
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here
TG_BOT_USERNAME=The_Devil_OSINT_bot
